{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window and detachable mixer window",
  "windows": ["main", "mixer"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    "dialog:default",
    "window-state:default"
  ]
}
